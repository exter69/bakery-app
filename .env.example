# Server
PORT=8080

# JWT
JWT_SECRET=your-secret-here

# Frontend CORS origin
FRONTEND_ORIGIN=http://localhost:5173

# Contact email for baker registration
CONTACT_EMAIL=admin@mieetbeurre.com

# Payment gateway: "stub" (dev) or "stripe" (production)
PAYMENT_GATEWAY=stub

# Stripe (only needed when PAYMENT_GATEWAY=stripe)
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email (optional — logs to stdout when not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@mieetbeurre.com
