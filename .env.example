# =============================================================================
# Environment Variables — Mie & Beurre Bakery App
# =============================================================================
# Legend:
#   [REQUIRED]   — must be set in production
#   [OPTIONAL]   — has a sensible default or falls back gracefully
#   [VERCEL]     — set in Vercel dashboard (frontend only)
#   [RAILWAY]    — set in Railway dashboard (backend only)

# --- Server [RAILWAY] ---
PORT=8080                         # [OPTIONAL] defaults to 8080

# --- Database [RAILWAY / REQUIRED in production] ---
# Railway provides DATABASE_URL automatically when you add a Postgres plugin.
# Uses in-memory store when not set (dev only).
DATABASE_URL=postgres://user:password@localhost:5432/bakery_app?sslmode=disable

# --- Authentication [RAILWAY / REQUIRED] ---
JWT_SECRET=your-secret-here       # [REQUIRED] use a strong random string in production

# --- Frontend CORS origin [RAILWAY / REQUIRED] ---
# Must match the Vercel production URL (e.g., https://mieetbeurre.com)
FRONTEND_ORIGIN=http://localhost:5173

# --- Contact email [RAILWAY / OPTIONAL] ---
CONTACT_EMAIL=admin@mieetbeurre.com

# --- Payment gateway [RAILWAY / REQUIRED for payments] ---
# "stub" for dev, "stripe" for production
PAYMENT_GATEWAY=stub

# --- Stripe [RAILWAY / REQUIRED when PAYMENT_GATEWAY=stripe] ---
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- Email [RAILWAY / OPTIONAL — logs to stdout when not configured] ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@mieetbeurre.com

# --- Push notifications [RAILWAY / OPTIONAL — disabled when not set] ---
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Error tracking [RAILWAY / OPTIONAL — disabled when not set] ---
SENTRY_DSN=
APP_ENV=development
APP_VERSION=

# --- Frontend [VERCEL] ---
# Set in Vercel dashboard. Points to the Railway backend URL including /api.
# Example: https://bakery-app-production.up.railway.app/api
# VITE_API_BASE_URL=https://your-railway-app.up.railway.app/api

# --- Frontend error tracking [VERCEL / OPTIONAL — disabled when not set] ---
# VITE_SENTRY_DSN=https://your-key@o123.ingest.sentry.io/456
# VITE_APP_ENV=production
# VITE_APP_VERSION=1.0.0

# --- Image upload storage [RAILWAY / OPTIONAL] ---
# "local" for development (serves from ./uploads), "s3" for production
UPLOAD_STORAGE=local
# S3 configuration (required when UPLOAD_STORAGE=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_CDN_BASE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
